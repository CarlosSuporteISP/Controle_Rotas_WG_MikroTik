# Créditos do projeto. Copie para creditos.env, edite e rode:
#     python3 -B scripts/readme_padrao.py creditos .        (no assistentes-ia; use o caminho do script)
# O README é atualizado só entre <!-- creditos:inicio --> e <!-- creditos:fim -->. O resto do texto não muda.
#
# Pessoas: PESSOA_<n>_NOME, PESSOA_<n>_GITHUB, PESSOA_<n>_AJUDA   (n = 1, 2, 3, ... sem limite)
#   NOME    nome ou apelido
#   GITHUB  só o usuário (CarlosSuporteISP) ou a URL completa; vazio deixa o campo marcado para preencher
#   AJUDA   campo LIVRE: o tipo de ajuda que a pessoa deu. Exemplos: versionar código, teste de vulnerabilidade,
#           ideias, revisão, infraestrutura, documentação, testes de campo, tradução, design...
PESSOA_1_NOME="Carlos"
PESSOA_1_GITHUB="CarlosSuporteISP"
PESSOA_1_AJUDA="Idealização, direção e uso"

#PESSOA_2_NOME="Nome da nova pessoa"
#PESSOA_2_GITHUB="usuario-no-github"
#PESSOA_2_AJUDA="teste de vulnerabilidade"

# Inteligências artificiais: IA_<n>_NOME, IA_<n>_LINK, IA_<n>_AJUDA (só as que participaram do projeto)
#IA_1_NOME="Claude (Claude Code) — Anthropic"
#IA_1_LINK="https://claude.com/claude-code"
#IA_1_AJUDA="versionar código"

